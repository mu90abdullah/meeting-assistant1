# ╔══════════════════════════════════════════════════════════════════╗
# ║         Meeting Assistant Agent — Environment Variables          ║
# ║   Copy this file to .env and fill in your actual values.         ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your OpenAI API key (required for both Whisper API and GPT-4o)
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM model to use for meeting analysis (default: gpt-4o)
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# Whisper transcription mode: "api" (OpenAI Whisper API) or "local" (local model)
# - "api"  : Fast, requires paid API credits, no GPU needed
# - "local": Free, requires: pip install openai-whisper + ffmpeg in PATH
WHISPER_MODE=api

# Local Whisper model size (only used when WHISPER_MODE=local)
# Options: tiny, base, small, medium, large (larger = more accurate & slower)
WHISPER_LOCAL_MODEL=base

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-gmail-app-password   ← NOT your Gmail password!
#     → Enable 2FA → Google Account → Security → App Passwords

# Outlook/Microsoft 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_USE_TLS=true

# Display name shown in the "From" field
EMAIL_FROM_NAME=Meeting Assistant

# ── Agent behavior ─────────────────────────────────────────────────────────────
# Number of retries on transient API errors
MAX_RETRIES=3

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory where JSON output files are saved (created automatically)
OUTPUT_DIR=./output
